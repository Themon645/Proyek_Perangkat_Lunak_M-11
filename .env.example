APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGIN=*

# PostgreSQL (Neon Cloud Serverless)
# Format dari console https://neon.tech:
DATABASE_URL=postgres://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DB_AUTO_MIGRATE=true
DB_SEED_DUMMY=true
DB_LOG_LEVEL=warn

# Neon Object Storage (S3-Compatible)
AWS_ENDPOINT_URL_S3=https://[branch_id].storage.[cell].[region].aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=payment-proofs

# Alternatif Parameter Lokal PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_NAME=araya-dev
# DB_SSLMODE=disable

# Modul M9 GRN synchronization (Opsional)
M9_GRN_ENDPOINT=
