APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGIN=*

# MongoDB Atlas Integration (Serverless)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=procurement
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0

# PostgreSQL Integration (Optional if using Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=araya-dev
DB_SSLMODE=disable
DB_LOG_LEVEL=warn
DB_AUTO_MIGRATE=false
DB_SEED_DUMMY=false

# Modul M9 GRN synchronization
M9_GRN_ENDPOINT=

